{
  "hosting": {
    "site": "dongne-studio",
    "public": ".",
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebase/**",
      ".firebase",
      ".gitignore",
      ".git",
      ".git/**",
      ".nojekyll",
      "**/.DS_Store",
      "**/node_modules/**",
      "README.md",
      "CNAME",
      "**/_build.js",
      "_landing/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(css|svg|png|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ]
  }
}
